{
  "name": "pi-e2b",
  "version": "0.1.0",
  "description": "Run Pi's read, edit, write, bash, and grep tools in persistent E2B sandboxes",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/stym06/pi-e2b.git" },
  "homepage": "https://github.com/stym06/pi-e2b#readme",
  "bugs": { "url": "https://github.com/stym06/pi-e2b/issues" },
  "keywords": ["pi-package", "pi-extension", "e2b", "sandbox"],
  "engines": { "node": ">=22" },
  "pi": { "extensions": ["./index.ts"] },
  "files": ["index.ts", "src", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "test:live": "node --import tsx scripts/live.ts",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "dependencies": { "e2b": "^2.51.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.0"
  }
}
